# Copia este archivo como .env y llénalo. El .env NO se sube a git.

# Portal Resultados iPLUS (cuenta compartida de "EMIS Cardiología")
PORTAL_URL=https://resultados.tecsalud.mx
PORTAL_USUARIO=
PORTAL_PASSWORD=

# Google Sheets: el ID es lo que va entre /d/ y /edit en el link
SHEET_ID=
SHEET_ID_PRUEBA=
# Archivo OAuth descargado de Google Cloud (ver README)
GOOGLE_CREDENCIALES=credentials.json

# Opcionales
PARALELO=4          # pacientes leídos a la vez
DIAS_MAX=7          # cuántos días hacia atrás buscar como máximo
CARPETA_PNG=salida/png
# CHROMIUM_PATH=    # solo si usas un Chrome/Chromium propio
